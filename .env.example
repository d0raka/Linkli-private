# PayPal hosted checkout for launch. Card/bit stay empty until a later optional Takbull rail.
BILLING_CREDIT_CARD_URL=
BILLING_PAYPAL_URL=
BILLING_BIT_URL=
# Optional fallback used when a method-specific URL is absent.
BILLING_CHECKOUT_URL=
# Optional hosted customer portal for updating or cancelling an active plan.
BILLING_PORTAL_URL=
# HMAC secret used by the billing webhook adapter. Sign
# `${x-linkli-timestamp}.${rawJsonBody}` with SHA-256 and send the lowercase
# hex digest in x-linkli-signature. Include a unique eventId in every payload.
BILLING_WEBHOOK_SECRET=

# Secret used outside the database to strengthen password hashes. Generate a
# cryptographically random value and never change it after users register.
AUTH_PEPPER=

# Comma-separated owner/admin email allowlist. Admin authorization is checked
# on the server for every dashboard page and management API request.
ADMIN_EMAILS=owner@example.com

# Cloudflare Access application AUD. When set, /admin and /api/admin require
# the cf-access-authenticated-user-email header (put Access in front of those
# paths in the Cloudflare dashboard; this is defense in depth for direct hits).
CF_ACCESS_AUD=

# Transactional account emails (verification and password recovery).
# Create a sending-only API key and verify the sender domain with Resend.
RESEND_API_KEY=
EMAIL_FROM=Linkli <account@example.com>
EMAIL_REPLY_TO=

# Separate HMAC key for signed checkout correlation. Values never committed.
BILLING_STATE_SECRET=
# WARNING: BILLING_DEMO_MODE must be ABSENT in production, even when false.
# Demo checkout is accepted only with NODE_ENV=development.

# PayPal-only launch: a hosted Checkout URL must carry our unique order ID.
# Static PayPal.me links do not bind payments to pending orders.
PAYPAL_WEBHOOK_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=live

# Server-side Turnstile verification. Public site key is delivered by server pages.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=linkli.online
# TURNSTILE_TEST_BYPASS may only be used in development/tests; absent in production.
SUPPORT_INBOX=
CF_ACCESS_TEAM_DOMAIN=
