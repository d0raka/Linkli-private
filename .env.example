# Hosted subscription checkout URLs. Credit card and bit can be supplied by
# an Israeli provider such as Grow/Cardcom/Takbull; PayPal uses its own link.
BILLING_CREDIT_CARD_URL=
BILLING_PAYPAL_URL=
BILLING_BIT_URL=
# Optional fallback used when a method-specific URL is absent.
BILLING_CHECKOUT_URL=
# HMAC secret used by the billing webhook adapter. Sign
# `${x-linkli-timestamp}.${rawJsonBody}` with SHA-256 and send the lowercase
# hex digest in x-linkli-signature. Include a unique eventId in every payload.
BILLING_WEBHOOK_SECRET=
